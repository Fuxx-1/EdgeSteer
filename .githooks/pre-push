#!/bin/sh

set -eu

root="$(git rev-parse --show-toplevel)" || exit 1
remote_name="$1"
zero_oid="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_oid" = "$zero_oid" ] && continue
    commit="$(git rev-parse "${local_oid}^{commit}" 2>/dev/null || true)"
    [ -n "$commit" ] || continue

    for pending in $(git rev-list "$commit" --not --remotes="$remote_name"); do
        if ! sh "$root/scripts/check-privacy.sh" --tree "$pending" --check-identity; then
            status=1
        fi
    done
done

exit "$status"
