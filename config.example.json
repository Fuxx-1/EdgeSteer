{
  "listener": {
    "address": "127.0.0.1:53",
    "allow_remote": false
  },
  "cloudflare": {
    "range_refresh_secs": 86400
  },
  "request_timeout_ms": 8000,
  "entry": "local-keyword",
  "rule_sets": [
    {
      "tag": "geosite-cn",
      "type": "remote",
      "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
      "update_interval_secs": 86400,
      "timeout_ms": 10000
    }
  ],
  "plugins": [
    {
      "tag": "cloudflare-preferred",
      "type": "cloudflare_preferred",
      "rewrite_ttl_secs": 60,
      "preferred": {},
      "optimizer": {
        "enabled": false,
        "interval_secs": 21600,
        "test_host": "www.cloudflare.com",
        "test_path": "/cdn-cgi/trace",
        "test_port": 443,
        "timeout_ms": 3000,
        "concurrency": 32,
        "samples_per_cidr": 40,
        "probes_per_candidate": 3,
        "compatibility_hosts": [],
        "excluded_candidates": [
          "172.64.228.0/24"
        ],
        "max_candidates": 1040,
        "candidates": [
          "173.245.48.0/20",
          "103.21.244.0/22",
          "103.22.200.0/22",
          "103.31.4.0/22",
          "141.101.64.0/18",
          "108.162.192.0/18",
          "190.93.240.0/20",
          "188.114.96.0/20",
          "197.234.240.0/22",
          "198.41.128.0/17",
          "162.158.0.0/15",
          "104.16.0.0/13",
          "104.24.0.0/14",
          "172.64.0.0/17",
          "172.64.128.0/18",
          "172.64.192.0/19",
          "172.64.224.0/22",
          "172.64.229.0/24",
          "172.64.230.0/23",
          "172.64.232.0/21",
          "172.64.240.0/21",
          "172.64.248.0/21",
          "172.65.0.0/16",
          "172.66.0.0/16",
          "172.67.0.0/16",
          "131.0.72.0/22"
        ]
      }
    }
  ],
  "layers": [
    {
      "tag": "local-keyword",
      "type": "local",
      "timeout_ms": 1800,
      "refresh_secs": 30,
      "next": "cn-doh",
      "match": {
        "mode": "contains",
        "keywords": ["b2c", "mi", "local"]
      }
    },
    {
      "tag": "cn-doh",
      "type": "doh",
      "address": "120.53.53.53:443",
      "url": "https://doh.pub/dns-query",
      "timeout_ms": 2800,
      "plugin": "cloudflare-preferred",
      "next": "cloudflare-doh",
      "fallback": "cloudflare-doh",
      "match": {
        "rule_sets": ["geosite-cn"]
      }
    },
    {
      "tag": "cloudflare-doh",
      "type": "doh",
      "address": "1.1.1.1:443",
      "url": "https://cloudflare-dns.com/dns-query",
      "timeout_ms": 2800,
      "plugin": "cloudflare-preferred",
      "fallback": "local-fallback"
    },
    {
      "tag": "local-fallback",
      "type": "local",
      "timeout_ms": 1800,
      "refresh_secs": 30
    }
  ]
}
