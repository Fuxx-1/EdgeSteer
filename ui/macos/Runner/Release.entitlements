<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The interface is not sandboxed: it must read the agent's control record
	  from ~/Library/Application Support/EdgeSteer and open the authenticated
	  loopback control connection to the agent. The sandbox blocks both, which
	  would leave the interface permanently disconnected from the DNS service.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
